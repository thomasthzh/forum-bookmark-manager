<Window x:Class="Rfbm.Native.BridgeSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="启用 Edge 扩展桥接"
        Width="610"
        Height="455"
        MinWidth="560"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="连接手动快照与页面标注" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="接收器只监听 127.0.0.1，并只接受你填写的精确扩展 origin。原始 HTML 仅在内存解析，不保存到磁盘。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="解压缩扩展目录" FontWeight="SemiBold" />
            <DockPanel Margin="0,7,0,0">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="复制路径" Click="CopyPath_Click" />
                <TextBox x:Name="ExtensionPathBox" IsReadOnly="True" />
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Edge 显示的扩展 ID" FontWeight="SemiBold" />
            <TextBox x:Name="ExtensionIdBox" Margin="0,7,0,0" MaxLength="32" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="站点家族标识" FontWeight="SemiBold" />
            <TextBox x:Name="SiteFamilyBox" Margin="0,7,0,0" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="4"
                   Margin="0,14,0,0"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="5" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="92" Margin="0,0,10,0" Content="取消" IsCancel="True" Click="Cancel_Click" />
            <Button Width="132" Style="{StaticResource PrimaryButton}" Content="启动本地桥接" IsDefault="True" Click="Start_Click" />
        </StackPanel>
    </Grid>
</Window>
