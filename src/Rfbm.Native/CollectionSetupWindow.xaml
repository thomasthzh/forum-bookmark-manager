<Window x:Class="Rfbm.Native.CollectionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="开始采集"
        Width="620"
        Height="760"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="把论坛收藏带回本地"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="R-fbm 会完整验证收藏分页；登录和验证码只在可见 Edge 中由你完成。"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="收藏页 URL" FontWeight="SemiBold" />
            <TextBox x:Name="FavoritesUrlBox"
                     Margin="0,8,0,0"
                     ToolTip="例如论坛的 home.php 收藏页；不会写入仓库" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="站点家族标识" FontWeight="SemiBold" />
                <TextBox x:Name="SiteFamilyBox"
                         Margin="0,8,0,0"
                         ToolTip="主站和镜像共用同一个稳定标识" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="帖子并发" FontWeight="SemiBold" />
                <TextBox x:Name="ConcurrencyBox" Margin="0,8,0,0" Text="4" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="镜像 origin（可选，每行一个）" FontWeight="SemiBold" />
            <TextBox x:Name="MirrorsBox"
                     Height="86"
                     Margin="0,8,0,0"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" />
        </StackPanel>

        <Border Grid.Row="4"
                Margin="0,18,0,0"
                Padding="14"
                CornerRadius="8"
                Background="{StaticResource RaisedPanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <CheckBox x:Name="VerifyFirstCheckBox"
                          IsChecked="True"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          Content="先打开可见 Edge 完成登录验证（推荐）" />
                <TextBlock Margin="24,7,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"
                           Text="浏览器使用 R-fbm 独立 profile；关闭验证页后才开始无头批量采集。"
                           TextWrapping="Wrap" />
                <Expander Margin="0,14,0,0"
                          Header="可选：Mihomo 本机线路恢复">
                    <StackPanel Margin="24,10,0,0">
                        <CheckBox x:Name="EnableMihomoCheckBox"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  Content="主站与镜像均网络失败后，切换一次指定线路" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="控制器（仅允许回环 IP）" FontSize="12" />
                                <TextBox x:Name="MihomoControllerBox"
                                         Margin="0,5,0,0"
                                         Text="http://127.0.0.1:9090" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="策略组" FontSize="12" />
                                <TextBox x:Name="MihomoGroupBox" Margin="0,5,0,0" Text="AUTO" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="目标线路" FontSize="12" />
                                <TextBox x:Name="MihomoProxyBox" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="控制器密钥（不保存）" FontSize="12" />
                                <PasswordBox x:Name="MihomoSecretBox" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="5"
                   Margin="0,14,0,0"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="6"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="92" Margin="0,0,10,0" Content="取消" IsCancel="True" Click="Cancel_Click" />
            <Button Width="132"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Content="验证并开始"
                    Click="Start_Click" />
        </StackPanel>
    </Grid>
</Window>
