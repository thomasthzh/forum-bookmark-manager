<Window x:Class="Rfbm.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="R-fbm · 论坛藏宝阁"
        Height="820"
        Width="1380"
        MinHeight="680"
        MinWidth="1120"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- Top command bar -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="255" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12"
                            Background="{StaticResource AccentBrush}">
                        <TextBlock Text="R" FontSize="23" FontWeight="Bold"
                                   Foreground="#1E150A"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="R-fbm" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="论坛藏宝阁 · 本地收藏档案馆"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Margin="20,0,22,0" MaxWidth="650">
                    <TextBlock Text="⌕" FontSize="22"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="12,0,0,1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBox Height="42"
                             Padding="42,8,12,8"
                             FontSize="14"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="搜索标题、正文、标签、笔记、链接上下文" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BridgeButton"
                            Margin="0,0,10,0"
                            Content="⇄  扩展桥接"
                            Click="Bridge_Click" />
                    <Button Margin="0,0,10,0"
                            Content="↻  刷新"
                            Click="Refresh_Click" />
                    <Button Margin="0,0,10,0"
                            Content="✦  随机翻一帖"
                            Click="Random_Click" />
                    <Button Style="{StaticResource PrimaryButton}"
                            Padding="16,8"
                            Content="＋  开始采集"
                            Click="StartCollection_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Three-pane workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="370" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom"
                            Margin="0,14,0,0"
                            Padding="12"
                            CornerRadius="8"
                            Background="{StaticResource RaisedPanelBrush}">
                        <StackPanel>
                            <TextBlock Text="灵感漫游" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding RediscoveryText}" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Margin="10,0,0,7" Text="收藏库"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button Style="{StaticResource NavButton}" Content="▦   全部收藏" Click="FilterAll_Click" />
                            <Button Style="{StaticResource NavButton}" Content="★   星标收藏" Click="FilterStarred_Click" />

                            <TextBlock Margin="10,20,0,7" Text="处理状态"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button Style="{StaticResource NavButton}" Content="○   未下载" Tag="NotDownloaded" Click="FilterStatus_Click" />
                            <Button Style="{StaticResource NavButton}" Content="✓   已下载" Tag="Downloaded" Click="FilterStatus_Click" />
                            <Button Style="{StaticResource NavButton}" Content="!   链接失效" Tag="LinkInvalid" Click="FilterStatus_Click" />

                            <TextBlock Margin="10,20,0,7" Text="常用类型"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button Style="{StaticResource NavButton}" Content="▣   游戏" Tag="游戏" Click="FilterType_Click" />
                            <Button Style="{StaticResource NavButton}" Content="⌘   工具" Tag="工具" Click="FilterType_Click" />
                            <Button Style="{StaticResource NavButton}" Content="◇   教程" Tag="教程" Click="FilterType_Click" />
                            <Button Style="{StaticResource NavButton}" Content="▤   素材" Tag="素材" Click="FilterType_Click" />

                            <Separator Margin="8,18" Background="{StaticResource BorderBrush}" />
                            <Button Style="{StaticResource NavButton}"
                                    Content="⇧   导入旧版收藏"
                                    Click="ImportLegacy_Click" />
                            <Button Style="{StaticResource NavButton}"
                                    Foreground="{StaticResource DangerBrush}"
                                    Content="♲   回收站"
                                    Click="FilterTrash_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Bookmark list -->
            <Grid Grid.Column="2" Margin="16,14,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="收藏" FontSize="22" FontWeight="SemiBold" />
                        <Border Margin="10,1,0,0" Padding="7,2" CornerRadius="9"
                                Background="{StaticResource RaisedPanelBrush}">
                            <TextBlock Text="{Binding TotalCount}" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Margin="0,0,7,0" Content="标为已下载" Tag="Downloaded" Click="BulkStatus_Click" />
                        <Button Margin="0,0,7,0" Content="标为失效" Tag="LinkInvalid" Click="BulkStatus_Click" />
                        <Button x:Name="TrashActionButton"
                                Style="{StaticResource DangerButton}"
                                Content="移入回收站"
                                Click="TrashSelected_Click" />
                        <Button x:Name="RestoreActionButton"
                                Margin="7,0,0,0"
                                Visibility="Collapsed"
                                Content="恢复"
                                Click="RestoreSelected_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        CornerRadius="10"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="PostGrid"
                                  ItemsSource="{Binding Posts}"
                                  SelectedItem="{Binding SelectedPost, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  SelectionChanged="PostGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="收藏内容" Width="*" MinWidth="250">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Type}" FontSize="11"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock Text="  ·  " FontSize="11"
                                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                                    <TextBlock Text="{Binding TagsText}" FontSize="11"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="星标" Width="54">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding StarText}"
                                                    FontSize="18"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="5"
                                                    Click="RowStar_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="状态" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding StatusText}"
                                                    Padding="8,4"
                                                    Click="RowStatus_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="收藏时间" Binding="{Binding FavoriteTimeText}" Width="136" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="◇" FontSize="42" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Margin="0,12,0,0" Text="你的藏宝阁还空着" FontSize="18"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,7,0,0"
                                       Text="连接论坛收藏页，R-fbm 会把旧收藏完整带回本地。"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- Details -->
            <Border Grid.Column="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,16"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="收藏详情" FontSize="17" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="打开原帖 ↗" Click="OpenPost_Click" />
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <TextBlock Text="{Binding SelectedPost.Title}"
                                       FontSize="20" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Padding="8,3" CornerRadius="9" Background="{StaticResource RaisedPanelBrush}">
                                    <TextBlock Text="{Binding SelectedPost.Type}" FontSize="11"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <TextBlock Margin="10,3,0,0" Text="{Binding SelectedPost.StatusText}"
                                           FontSize="11" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Margin="10,3,0,0" Text="{Binding SelectedPost.FavoriteTimeText}"
                                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>

                            <UniformGrid Columns="3" Margin="0,18,0,0">
                                <Border Padding="10" Margin="0,0,6,0" CornerRadius="7" Background="{StaticResource RaisedPanelBrush}">
                                    <StackPanel><TextBlock Text="浏览" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding SelectedPost.VisitCount, TargetNullValue=-}" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                                <Border Padding="10" Margin="3,0" CornerRadius="7" Background="{StaticResource RaisedPanelBrush}">
                                    <StackPanel><TextBlock Text="下载" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding SelectedPost.DownloadCount, TargetNullValue=-}" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                                <Border Padding="10" Margin="6,0,0,0" CornerRadius="7" Background="{StaticResource RaisedPanelBrush}">
                                    <StackPanel><TextBlock Text="收藏" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding SelectedPost.FavoriteCount, TargetNullValue=-}" FontWeight="SemiBold" /></StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Margin="0,18,0,0" Padding="13" CornerRadius="8"
                                    Background="#2AF4B860" BorderBrush="#60F4B860" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="提取 / 解压密码" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding SelectedPost.ExtractPassword, TargetNullValue=未发现}"
                                                   FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="复制" Click="CopyPassword_Click" />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,20,0,7" Text="正文摘要" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedPost.BodyText}"
                                       MaxHeight="180" TextWrapping="Wrap"
                                       Foreground="{StaticResource BodyTextBrush}" />

                            <Grid Margin="0,20,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="资源链接" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPost.ResourceLinks.Count, StringFormat={}{0} 个}"
                                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SelectedPost.ResourceLinks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="11" Margin="0,0,0,7" CornerRadius="7"
                                                Background="{StaticResource RaisedPanelBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding ContextText}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding Url}"
                                                           FontSize="10" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource SuccessBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,18,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="本地图片" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPost.Images.Count, StringFormat={}{0} / 9}"
                                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SelectedPost.Images}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="100" Height="64" Margin="0,0,7,7" Padding="7"
                                                CornerRadius="6" Background="{StaticResource RaisedPanelBrush}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Position, StringFormat=图片 {0}}" FontSize="11" />
                                                <TextBlock Margin="0,3,0,0" Text="{Binding DownloadStatus}"
                                                           FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,18,0,7" Text="我的标签" FontWeight="SemiBold" />
                            <TextBox x:Name="TagsEditor" ToolTip="逗号分隔" />
                            <Button Margin="0,7,0,0" HorizontalAlignment="Right" Content="保存标签" Click="SaveTags_Click" />

                            <TextBlock Margin="0,18,0,7" Text="我的笔记" FontWeight="SemiBold" />
                            <TextBox x:Name="NoteEditor" Height="94" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            <Button Margin="0,7,0,18" HorizontalAlignment="Right" Content="保存笔记" Click="SaveNote_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Persistent collection status -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" />
                    <TextBlock Margin="14,0,0,0" Text="{Binding CollectionProgressText}" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="12,0" Text="{Binding WorkingSetText}"
                           FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="3" x:Name="CancelCollectionButton"
                        Padding="9,3" Content="取消采集" IsEnabled="False"
                        Click="CancelCollection_Click" />
                <ProgressBar Grid.ColumnSpan="4" VerticalAlignment="Bottom"
                             IsIndeterminate="{Binding IsCollectionRunning}" />
            </Grid>
        </Border>
    </Grid>
</Window>
