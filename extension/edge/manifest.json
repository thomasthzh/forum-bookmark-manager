{
  "manifest_version": 3,
  "name": "R-fbm Forum Bridge",
  "description": "由用户手动把当前论坛页面快照或选择器配置发送给本地 R-fbm。",
  "version": "0.2.0",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:53112/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "发送到 R-fbm"
  }
}
